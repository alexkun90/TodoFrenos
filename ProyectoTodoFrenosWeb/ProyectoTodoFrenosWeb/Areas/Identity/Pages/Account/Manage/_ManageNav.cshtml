@using DAL
@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<ul class="nav nav-pills flex-column">
    <li class="nav-item">
        <a class="nav-link d-flex align-items-center @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">
            <i class="bi bi-person me-2"></i> Perfil
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link d-flex align-items-center @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">
            <i class="bi bi-lock me-2"></i> Contraseña
        </a>
    </li>
    @if (hasExternalLogins)
    {
        <li id="external-logins" class="nav-item">
            <a id="external-login" class="nav-link d-flex align-items-center @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins">
                <i class="bi bi-box-arrow-in-right me-2"></i> Inicios de Sesión Externos
            </a>
        </li>
    }
    <li class="nav-item dropdown position-relative">
        <a class="nav-link dropdown-toggle d-flex align-items-center @ManageNavPages.OrderListNavClass(ViewContext)"
           id="order-list"
           role="button"
           data-bs-toggle="dropdown"
           aria-expanded="false">
            <i class="bi bi-list me-2"></i> Lista de Pedidos
        </a>
        <ul class="dropdown-menu shadow border-0 mt-2" aria-labelledby="order-list">
            <li>
                <a class="dropdown-item py-2" asp-controller="Orders" asp-action="GetMyDelayedOrders">
                   <i class="bi bi-clock me-2"></i> Pedidos Vencidos
                </a>
            </li>
            <li>
                <a class="dropdown-item py-2" asp-controller="Orders" asp-action="GetMyPendingOrders">
                    <i class="bi bi-hourglass-split me-2"></i> Pedidos Pendientes
                </a>
            </li>
            <li>
                <a class="dropdown-item py-2" asp-controller="Orders" asp-action="GetMyDeliveredOrders">
                    <i class="bi bi-check-circle me-2"></i> Pedidos Completados
                </a>
            </li>
            
        </ul>
    </li>
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link d-flex align-items-center @ManageNavPages.MyPaperNavClass(ViewContext)" id="mypaper" asp-controller="Appointments" asp-action="MyPaper">
                <i class="bi bi-file-earmark-text me-2"></i> Papelera
            </a>
        </li>
    </ul>
</ul>

<style>
    .nav-pills .nav-link {
        border-radius: 0.5rem;
        padding: 1rem;
        transition: background-color 0.3s, color 0.3s;
        color: #4f5d75; /* Color de texto por defecto */
    }

        .nav-pills .nav-link.active {
            background-color: #4f5d75;
            color: #ffffff;
        }

        .nav-pills .nav-link:hover {
            background-color: #b7bfc7;
            color: #4f5d75;
        }

    .nav-item {
        margin-bottom: 0.5rem;
    }

    .nav-link i {
        font-size: 1.25rem;
    }

    .d-flex {
        display: flex;
        align-items: center;
    }

    .me-2 {
        margin-right: 0.5rem;
    }
</style>