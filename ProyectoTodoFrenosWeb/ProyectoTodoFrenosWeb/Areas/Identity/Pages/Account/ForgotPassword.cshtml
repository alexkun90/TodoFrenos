@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "¿Olvidaste tu contraseña?";
}
<div class="container mt-5" style="margin-bottom:200px">
    <h1 class="text-center mb-4 mt-5">@ViewData["Title"]</h1>
    <h3 class="text-center mb-4">Ingresa tu correo electrónico para restablecer tu contraseña.</h3>
    <hr />
    <link href="~/estilos/css/custom.css" rel="stylesheet" />
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-6">
                <div class="card shadow border-light">
                    <div class="card-body mb-3">
                        <form method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                            <div class="form-floating mb-4">
                                <input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                                <label asp-for="Input.Email" class="form-label">Dirección de correo electrónico</label>
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>
                            <button type="submit" class="w-100 btn btn-agree">Restablecer Contraseña</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <br />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}