@model DAL.Models.PlanillaEmpleado

@{
    ViewBag.Title = "Detalles de la Planilla";
}

<head>
    <link href="~/estilos/css/templatemo.css" rel="stylesheet" />
    <link href="~/estilos/css/custom.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
</head>

<div class="container mt-5">
    <h2 class="text-center mb-4">Reporte Planilla Empleado</h2>
    <div style="border-top: 1px solid #ccc; margin: 20px 0;"></div>

    <div class="row">
        <div class="col-md-8 offset-md-2">
            <!-- Información del Empleado -->
            <div class="card mb-4">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-8">Cédula</dt>
                        <dd class="col-sm-4">@Model.Cedula</dd>

                        <dt class="col-sm-8">Nombre Completo</dt>
                        <dd class="col-sm-4">@Model.NombreEmpleado @Model.ApellidoEmpleado</dd>

                        <dt class="col-sm-8">Puesto</dt>
                        <dd class="col-sm-4">@Model.Puesto</dd>
                    </dl>
                </div>
            </div>

            <!-- Detalles de la Nómina -->
            <div class="card mb-4">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-8">ID de Nómina</dt>
                        <dd class="col-sm-4">@Model.NominaId</dd>

                        <dt class="col-sm-8">Fecha de Pago</dt>
                        <dd class="col-sm-4">@Model.FechaPago?.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-8">Salario Base</dt>
                        <dd class="col-sm-4">₡@Model.SalarioBruto?.ToString("N")</dd>

                        <div style="border-top: 1px solid #ccc; margin: 10px 0;"></div>
                        <dt class="col-sm-8">Pluses Salariales</dt>
                        <dd class="col-sm-4">₡@Model.SalarioNetoFinal?.ToString("N")</dd>
                        <div style="border-top: 1px solid #ccc; margin: 10px 0;"></div>
                    </dl>
                </div>
            </div>

            <!-- Deducciones -->
            <div class="card mb-4">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-8">SEN (Seguro Enfermedad)</dt>
                        <dd class="col-sm-4">₡@Model.SEM?.ToString("N")</dd>

                        <dt class="col-sm-8">IVM (Invalidez, Vejez y Muerte)</dt>
                        <dd class="col-sm-4">₡@Model.IVM?.ToString("N")</dd>

                        <dt class="col-sm-8">LPT (Aporte Trabajador BP)</dt>
                        <dd class="col-sm-4">₡@Model.LPT?.ToString("N")</dd>

                        <dt class="col-sm-8">Impuesto de Renta</dt>
                        <dd class="col-sm-4">₡@Model.ImpuestoRenta?.ToString("N")</dd>

                        <dt class="col-sm-8">Rebajo de Incapacidad</dt>
                        <dd class="col-sm-4">₡@Model.DescuentoIncapacitacion?.ToString("N")</dd>

                        <div style="border-top: 1px solid #ccc; margin: 10px 0;"></div>
                        <dt class="col-sm-8">Total de Deducciones</dt>
                        <dd class="col-sm-4">₡@Model.TotalDeducciones?.ToString("N")</dd>

                        <div style="border-top: 1px solid #ccc; margin: 10px 0;"></div>
                        <dt class="col-sm-8">Salario Neto</dt>
                        <dd class="col-sm-4">₡@Model.SalarioNetoFinal?.ToString("N")</dd>
                        <div style="border-top: 1px solid #ccc; margin: 10px 0;"></div>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
