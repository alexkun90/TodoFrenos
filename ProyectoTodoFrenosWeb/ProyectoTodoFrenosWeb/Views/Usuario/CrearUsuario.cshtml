@model RegistroModelo

@{
    ViewData["Title"] = "Registrar Usuario";
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<div class="full-screen-container">
    <div class="center-card">
        <h1>@ViewData["Title"]</h1>
        <form asp-action="CrearUsuario" onsubmit="return validateRoles()" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            @Html.HiddenFor(model => model.Password)
            @Html.HiddenFor(model => model.ConfirmPassword)
            @Html.HiddenFor(model => model.Activo)
            <div style="display: flex; gap: 20px;">
                <div class="form-column">
                    <div class="txt_field">
                        <input asp-for="NombreUsuario" class="form-control" aria-required="true" required />
                        <span></span>
                        <label>Nombre de Usuario</label>
                        <span asp-validation-for="NombreUsuario" class="text-danger"></span>
                    </div>
                    <div class="txt_field">
                        <input asp-for="PrimApellido" class="form-control" aria-required="true" required />
                        <span></span>
                        <label>Primer Apellido</label>
                        <span asp-validation-for="PrimApellido" class="text-danger"></span>
                    </div>
                    <div class="txt_field">
                        <input asp-for="SegunApellido" class="form-control" aria-required="true" required />
                        <span></span>
                        <label>Segundo Apellido</label>
                        <span asp-validation-for="SegunApellido" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-column">
                    <div class="txt_field">
                        <input asp-for="Email" class="form-control" aria-required="true" required />
                        <span></span>
                        <label>Correo Electrónico</label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3" id="rolesContainer">
                        <label class="form-label">Roles</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Roles" value="Admin" id="roleAdmin" @(Model.Roles != null && Model.Roles.Contains("Admin") ? "checked" : "")>
                            <label class="form-check-label" for="roleAdmin">Administrador</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Roles" value="User" id="roleUser" @(Model.Roles != null && Model.Roles.Contains("User") ? "checked" : "")>
                            <label class="form-check-label" for="roleUser">Usuario</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Roles" value="Mecanico" id="roleMecanico" @(Model.Roles != null && Model.Roles.Contains("Mecanico") ? "checked" : "")>
                            <label class="form-check-label" for="roleMecanico">Mecánico</label>
                        </div>
                        <span asp-validation-for="Roles" class="text-danger mt-2"></span>
                    </div>
                    <div class="mb-1">
                        <label class="form-label"></label>
                    </div>
                </div>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-custom">Registrar Usuario</button>
        </form>
    </div>
</div>

<script src="~/estilos/js/jquery-1.11.0.min.js"></script>
<script>
    function validateRolesAndFields() {
        const checkboxes = document.querySelectorAll('#rolesContainer .form-check-input');
        const rolesChecked = Array.from(checkboxes).some(checkbox => checkbox.checked);

        if (!rolesChecked) {
            checkboxes[0].setCustomValidity('Seleccione al menos un rol.');
        } else {
            checkboxes[0].setCustomValidity('');
        }

        const requiredFields = document.querySelectorAll('input[required]');
        let allValid = true;

        requiredFields.forEach(field => {
            if (!field.value.trim()) {
                field.setCustomValidity('Este campo es obligatorio.');
                field.reportValidity();
                allValid = false;
            } else {
                field.setCustomValidity('');
            }
        });
        if (rolesChecked && allValid) {
            return true;
        } else {
            const invalidField = document.querySelector(':invalid');
            if (invalidField) {
                invalidField.reportValidity();
            }
            return false;
        }
    }

    document.querySelector('form').onsubmit = validateRolesAndFields;
</script>
