@model DAL.Models.SupplierAppointment

@{
    ViewData["Title"] = "Create";
}

<div class="container d-flex justify-content-center align-items-center mt-5 mb-5">
    <div class="card rounded-3 p-4" style="width:750px !important">
        @* @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        } *@

        <div id="dynamicMessages"></div>

        <h3 class="mb-3">Agregar Cita</h3>
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="SupplierEmail" class="form-label">Correo Electrónico</label>
                <input asp-for="SupplierEmail" class="form-control" placeholder="correo electrónico" />
            </div>

            <div class="row mb-3">
                <div class="col-md-5">
                    <label asp-for="AppointCreationDate" class="form-label">Fecha y Hora de Cita</label>
                    <input asp-for="AppointCreationDate" id="appointCreationDate" class="form-control" type="datetime-local" aria-required="true" required />
                </div>

                <div class="col-md-7">
                    <label asp-for="Reason" class="form-label">Motivo</label>
                    <textarea asp-for="Reason" class="form-control" rows="4" aria-required="true" required></textarea>
                </div>
            </div>

            <button type="submit" class="btn btn-agree">Registrar Cita</button>
        </form>
    </div>
</div>

<div class="modal fade" id="timeValidationModal" tabindex="-1" aria-labelledby="timeValidationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #800000;">
                <h5 class="modal-title text-white" id="timeValidationModalLabel">
                    <i class="bi bi-exclamation-triangle-fill text-white"></i>
                    Hora Inválida
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <i class="bi bi-tools"></i> Nuestro horario de atención es de 7:30 a.m. a 5:00 p.m. Por favor, elija una hora dentro de este rango.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Función para mostrar mensajes dinámicos
            function showMessage(type, message) {
                const messageHtml = `
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;
                $('#dynamicMessages').html(messageHtml);
            }


        // $(document).ready(function () {
        //     function setDateTimeLimits() {
        //         var today = new Date();
        //         today.setHours(0, 0, 0, 0);
        //         var minDateTimeStr = today.toISOString().slice(0, 16);
        //         $('#appointCreationDate').attr('min', minDateTimeStr);

        //         $('#appointCreationDate').removeAttr('max');

        //         $('#appointCreationDate').on('change', function () {
        //             var selectedDate = new Date($(this).val());
        //             var minTime = new Date(selectedDate);
        //             minTime.setHours(7, 30, 0, 0);
        //             var maxTime = new Date(selectedDate);
        //             maxTime.setHours(17, 0, 0, 0);

        //             if (selectedDate < minTime || selectedDate > maxTime) {
        //                 alert("Nuestro horario de atención es de 7:30 a.m. a 5:00 p.m.");
        //                 $(this).val('');
        //             }
        //         });
        //     }

        //     setDateTimeLimits();
        // });

        $('form').submit(function (event) {
            event.preventDefault();
            const SupplierEmail = $('input[name="SupplierEmail"]').val();
            const appointDate = $('#appointCreationDate').val();
            const reason = $('textarea[name="Reason"]').val();

            if (!appointDate || !reason || !SupplierEmail) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Por favor, complete todos los campos.',
                    confirmButtonText: 'Aceptar'
                });
                return; // Si hay campos vacíos, no se envía el formulario
            }

            const form = $(this);
            $.ajax({
                type: form.attr('method'),
                url: form.attr('action'),
                data: form.serialize(),
                success: function () {
                    Swal.fire({
                        icon: 'success',
                        title: '¡Éxito!',
                        text: 'Tu solicitud de cita ha sido enviada correctamente. Pronto te contestaremos mediante correo eléctronico',
                        confirmButtonText: 'Aceptar'
                    });
                    form[0].reset(); // Limpiar el formulario
                },
                error: function (xhr, status, error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Ocurrió un error al registrar la cita. Intente nuevamente.',
                        confirmButtonText: 'Aceptar'
                    });
                    console.error('Error al enviar el formulario:', error);
                }
            });
        });

            function setDateTimeLimits() {
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                const minDateTimeStr = today.toISOString().slice(0, 16);
                $('#appointCreationDate').attr('min', minDateTimeStr);

                $('#appointCreationDate').on('change', function () {
                    const selectedDate = new Date($(this).val());
                    const minTime = new Date(selectedDate);
                    minTime.setHours(7, 30, 0, 0);
                    const maxTime = new Date(selectedDate);
                    maxTime.setHours(17, 0, 0, 0);

                    if (selectedDate < minTime || selectedDate > maxTime) {
                        $('#timeValidationModal').modal('show');
                        $(this).val('');
                    }
                });
            }

            setDateTimeLimits();
        });
    </script>
}